{
  "name": "pace-aihub",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:openapi": "cd apps/api && uv run python scripts/export_openapi.py",
    "contracts:gen": "pnpm contracts:openapi && pnpm -C packages/contracts gen",
    "dev:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d --build",
    "dev:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down"
  }
}
