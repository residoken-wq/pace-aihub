# Copy to .env (gitignored) and fill in. Never commit real values (ADR-015).
# Local dev database for infra/docker-compose.dev.yml
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PACE_LOG_LEVEL=INFO

# Used when running apps/api, apps/worker, or apps/web outside Docker (uv run / pnpm dev)
PACE_ENV=dev
PACE_DATABASE_URL=
PACE_VALKEY_URL=
API_INTERNAL_URL=
